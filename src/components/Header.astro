---
import { Image } from 'astro:assets';
import { nav, site } from '../data/site';
import logo from '../assets/images/logo.png';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href;
---

<header class="sticky top-0 z-50 bg-forest-dark/95 text-white backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
    <a href="/" class="flex items-center gap-3">
      <Image src={logo} alt="" width={44} height={44} class="size-11 rounded-full bg-mint/80" />
      <span class="font-display text-lg font-bold">{site.name}</span>
    </a>

    <nav aria-label="Main" class="hidden md:block">
      <ul class="flex gap-7 text-sm">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'border-b-2 py-1 transition-colors hover:text-mint',
                  isActive(item.href) ? 'border-mint font-semibold' : 'border-transparent',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <details class="group relative md:hidden">
      <summary class="cursor-pointer list-none rounded p-2 [&::-webkit-details-marker]:hidden" aria-label="Open menu">
        <svg class="size-6 group-open:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg class="hidden size-6 group-open:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </summary>
      <ul class="absolute right-0 mt-3 w-48 rounded-lg bg-forest-dark py-2 shadow-xl">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={['block px-5 py-2 hover:bg-forest', isActive(item.href) && 'font-semibold text-mint']}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </details>
  </div>
</header>
