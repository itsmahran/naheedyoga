---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  title: string;
  image: ImageMetadata;
}

const { title, image } = Astro.props;
---

<section class="relative isolate flex h-72 items-center justify-center overflow-hidden px-4 text-center sm:h-96">
  <Image src={image} alt="" widths={[640, 1280, 1920]} sizes="100vw" quality={65} loading="eager" data-parallax class="absolute inset-0 -z-10 size-full object-cover will-change-transform" />
  <div class="absolute inset-0 -z-10 bg-black/35"></div>
  <h1 class="max-w-4xl font-hero text-4xl leading-tight font-bold text-balance lowercase text-mint sm:text-6xl lg:text-7xl">{title}</h1>
</section>
